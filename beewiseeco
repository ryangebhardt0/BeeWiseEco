body{

font-family: "Times New Roman", serif;
margin:0;
background:#faf7f0;
color:#333;

}

header{

display:flex;
justify-content:center;
align-items:center;
position:relative;
padding:20px;

}

header h1{

font-size:22px;

}

.menu-button{

position:absolute;
left:20px;
font-size:26px;
cursor:pointer;

}

.cart{

position:absolute;
right:20px;
font-size:26px;
cursor:pointer;

}

#sideMenu{

position:fixed;
left:-260px;
top:0;
width:260px;
height:100%;
background:#1e1e1e;
color:white;
padding-top:80px;
transition:0.4s;

}

#sideMenu ul{

list-style:none;
padding:0;

}

#sideMenu li{

padding:12px 20px;

}

#sideMenu a{

color:white;
text-decoration:none;

}

.hero{

width:100%;
height:15cm;
overflow:hidden;

}

.honeycomb{

background:url('../images/honeycomb-bg.png');
background-size:cover;
height:100%;
display:flex;
justify-content:center;
align-items:center;
animation:honeyMove 40s linear infinite;

}

@keyframes honeyMove{

0%{background-position:0 0;}
100%{background-position:1000px 0;}

}

.bee{

width:7cm;

}

.about{

padding:50px;
text-align:center;

}

.about ul{

max-width:500px;
margin:auto;
text-align:left;

}

.product-grid{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:40px;
padding:40px;

}

.product{

text-align:center;

}

.product img{

width:200px;
border-radius:10px;

}

button{

padding:10px 18px;
border:none;
background:#f2b705;
color:white;
cursor:pointer;

}

.insta-grid{

display:grid;
grid-template-columns:repeat(3,1fr);
gap:10px;
padding:30px;

}

.insta{

background:#ddd;
height:120px;

}

footer{

text-align:center;
background:#eee;
padding:20px;

}

@media screen and (max-width:768px){

.bee{
width:5cm;
}

.hero{
height:10cm;
}

}

let cart=[]

function addToCart(name,price){

cart.push({name,price})

localStorage.setItem("cart",JSON.stringify(cart))

alert(name+" added to cart")

}

function goCheckout(){

window.location="checkout.html"

}

function toggleMenu(){

let menu=document.getElementById("sideMenu")

if(menu.style.left==="0px"){

menu.style.left="-260px"

}else{

menu.style.left="0px"

}

}

