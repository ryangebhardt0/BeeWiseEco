# ---------------------------------------------------------------------------
# DevsDen Inventory storefront API
# ---------------------------------------------------------------------------
# Base URL of the inventory backend. No trailing slash.
INVENTORY_API_URL=http://localhost:8000
# Secret key from Inventory → Settings → Online storefront → API keys.
# Server-side only: never prefix this with NEXT_PUBLIC_.
INVENTORY_API_KEY=sk_live_replace_me
# Hostname serving product images, so next/image will allow it.
STOREFRONT_IMAGE_HOST=

# ---------------------------------------------------------------------------
# PayFast
# ---------------------------------------------------------------------------
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
# Optional. If set here it must also be set in the PayFast dashboard.
PAYFAST_PASSPHRASE=
# "true" uses sandbox.payfast.co.za. Set to false only when going live.
PAYFAST_SANDBOX=true

# Public origin of this site, used to build PayFast return/cancel/notify URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
